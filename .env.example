# Optional (server-side, Vercel): private Robinhood Chain RPC used first by the /api/rpc proxy
RPC_URL=

# Optional (client-side): RPC the browser tries before /api/rpc — must allow CORS
VITE_RPC_URL=

# Optional: WalletConnect project id (free at https://dashboard.reown.com) to enable QR / mobile wallets
VITE_WALLETCONNECT_PROJECT_ID=
